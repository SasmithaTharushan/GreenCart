# ---------- Server (set these in Vercel → Project → Settings → Environment Variables) ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=greencart
JWT_SECRET=change-me-to-a-long-random-string
SELLER_EMAIL=admin@greencart.com
SELLER_PASSWORD=change-me

# Cloudinary (free) – needed for uploading new product images from the seller dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL, used in sitemap.xml / robots.txt (optional – defaults to the request host)
SITE_URL=https://greencart.vercel.app

# Optional: sync newsletter signups to a free Brevo list
BREVO_API_KEY=
BREVO_LIST_ID=

# ---------- Frontend (VITE_ vars are public – never put secrets here) ----------
VITE_CURRENCY=$
VITE_CURRENCY_CODE=USD
VITE_SITE_URL=https://greencart.vercel.app
VITE_WHATSAPP_NUMBER=94771234567
VITE_CONTACT_EMAIL=hello@greencart.com
VITE_GA_ID=
VITE_META_PIXEL_ID=
VITE_VERCEL_ANALYTICS=false
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=
